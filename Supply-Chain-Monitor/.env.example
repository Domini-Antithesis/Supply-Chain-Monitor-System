# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values. .env is gitignored and must
# never be committed -- every value below is a real credential once filled in.
# ---------------------------------------------------------------------------

# --- n8n instance -----------------------------------------------------------
N8N_HOST=localhost
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value
GENERIC_TIMEZONE=UTC
WEBHOOK_URL=http://localhost:5678/
# Host port for the n8n UI (http://localhost:5678).
N8N_HOST_PORT=5678

# The owner account the bootstrap script creates on first boot, and which you
# then use to log in at http://localhost:5678.
# Password needs 8+ characters, at least one uppercase letter and one number.
N8N_OWNER_EMAIL=replace-with-your-email@example.com
N8N_OWNER_PASSWORD=replace-with-a-strong-password
N8N_OWNER_FIRST_NAME=Supply
N8N_OWNER_LAST_NAME=Monitor

# --- NewsAPI (free "Developer" tier) ----------------------------------------
# Sign up at https://newsapi.org/register
# The free tier only permits requests from localhost, which matches this
# project's local Docker setup.
NEWSAPI_KEY=replace-with-your-newsapi-key

# --- Groq (free tier) -------------------------------------------------------
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=replace-with-your-groq-api-key

# --- Airtable ---------------------------------------------------------------
# Create a Personal Access Token at https://airtable.com/create/tokens with
# these scopes on your base:
#   data.records:read, data.records:write, schema.bases:read, schema.bases:write
# The schema scopes let the bootstrap script create both tables for you.
# AIRTABLE_BASE_ID is the "appXXXXXXXXXXXXXX" id from the base's URL or its
# API documentation page. Create an empty base first -- the tables inside it
# are provisioned automatically.
AIRTABLE_API_KEY=replace-with-your-airtable-personal-access-token
AIRTABLE_BASE_ID=replace-with-your-airtable-base-id
AIRTABLE_ALERTS_TABLE_NAME=Disruption Alerts
AIRTABLE_WATCHLIST_TABLE_NAME=Watchlist

# --- Slack ------------------------------------------------------------------
# Create an Incoming Webhook at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=replace-with-your-slack-incoming-webhook-url

# --- Email alerts -----------------------------------------------------------
# Where high-risk alerts are sent.
ALERT_EMAIL_TO=replace-with-procurement-team-email@example.com

# The SMTP sender. For Gmail use smtp.gmail.com:587 with an app password
# (https://support.google.com/accounts/answer/185833), not your login password.
# The bootstrap script turns these into an n8n credential automatically.
# Leave blank to skip email alerts entirely -- Slack alerts still work.
SMTP_HOST=replace-with-your-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-your-smtp-username
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_SECURE=false

# --- Dashboard --------------------------------------------------------------
# Host port for the dashboard UI (http://localhost:8080 by default).
DASHBOARD_PORT=8101
